#!/bin/sh
# Run nvimc — Neovim in a container.
# Usage: nvimc [-H <headers-dir>] [path] [nvim args...]
#
# Image resolution: set $NVIMC_IMAGE to override (e.g. to pin a version,
# or to point at a locally built image such as "nvimc" for development).

IMAGE="${NVIMC_IMAGE:-ghcr.io/hanapedia/nvimc:latest}"

HEADERS_DIR=""

while [ $# -gt 0 ]; do
  case "$1" in
    -H|--headers)
      HEADERS_DIR="$(realpath "$2")"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

TARGET="${1:-$(pwd)}"
TARGET="$(realpath "$TARGET")"
[ $# -gt 0 ] && shift

if [ -f "$TARGET" ]; then
  MOUNT_SRC="$(dirname "$TARGET")"
  NVIM_OPEN="/workspace/$(basename "$TARGET")"
else
  MOUNT_SRC="$TARGET"
  NVIM_OPEN="/workspace"
fi

MOUNTS="-v $MOUNT_SRC:/workspace"

# So the "nord" colorscheme plugin can read which variant (dark/light) was
# last set via the `nord-theme` command on the host -- same state file path
# convention it uses on the host ($XDG_STATE_HOME, defaulting to
# ~/.local/state), mounted at the equivalent path for the container's "dev"
# user. Created on the host first so docker doesn't auto-create it as root.
NORD_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nord"
mkdir -p "$NORD_STATE_DIR"
MOUNTS="$MOUNTS -v $NORD_STATE_DIR:/home/dev/.local/state/nord:ro"

# Run in the host's timezone. Besides matching timestamps, this is required
# for sharing the host's GOCACHE below: the go command keys its module index
# entries on file mtimes formatted with the local timezone, and with a
# mismatched zone (container UTC vs host) entries written by one side break
# the other ("package unsafe is not in std").
[ -e /etc/localtime ] && MOUNTS="$MOUNTS -v /etc/localtime:/etc/localtime:ro"

if [ -f "$MOUNT_SRC/go.mod" ]; then
  GOMODCACHE="${GOMODCACHE:-$HOME/go/pkg/mod}"
  MOUNTS="$MOUNTS -v $GOMODCACHE:/home/dev/go/pkg/mod:ro"

  # Persist the build cache across runs. Without this, gopls has to
  # type-check the whole dependency graph from scratch on every container
  # start (--rm wipes /home/dev/.cache/go-build), which is what causes the
  # 10-15s wait before gopls responds on dependency-heavy modules.
  GOCACHE="${GOCACHE:-$HOME/.cache/go-build}"
  mkdir -p "$GOCACHE"
  MOUNTS="$MOUNTS -v $GOCACHE:/home/dev/.cache/go-build"
fi

if [ -z "$HEADERS_DIR" ] && [ -d "$MOUNT_SRC/.dev-headers" ]; then
  HEADERS_DIR="$MOUNT_SRC/.dev-headers"
fi

if [ -n "$HEADERS_DIR" ]; then
  MOUNTS="$MOUNTS -v $HEADERS_DIR:/usr/local/include:ro"
fi

# Run as the host user so files edited/created in /workspace keep the
# caller's ownership, regardless of the UID baked into the image. HOME is
# set explicitly since the host UID usually has no passwd entry in the image.
docker run --rm -it \
  --network=none \
  --user "$(id -u):$(id -g)" \
  -e HOME=/home/dev \
  -e TERM="$TERM" \
  -e COLORTERM="${COLORTERM:-truecolor}" \
  $MOUNTS \
  "$IMAGE" "$NVIM_OPEN" "$@"
